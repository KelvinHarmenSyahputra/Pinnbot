# Pinnbot Configuration
# Copy this file to .env and configure your values

# AI Provider / 9router (OpenAI-Compatible endpoint)
AI_BASE_URL=http://127.0.0.1:20852/v1
AI_API_KEY=your_9router_or_openai_api_key
AI_DEFAULT_MODEL=ag/gemini-3.8-flash-high

# WhatsApp Group Lockdown (Leave empty during testing or set to your 120363xxxxxx@g.us)
ALLOWED_GROUP_ID=

# Bot Identity in Group
BOT_NAMES=pinnbot,cow,cil,pin
OWNER_NUMBER=

# Mode: set to true to connect WhatsApp Baileys, false for local test server
WHATSAPP_ENABLED=false
PORT=20856
